# Copiar a hermes-mcp.env (no se versiona) y completar.
# Desde el contenedor, la Mongo del equipo se alcanza como host.docker.internal
# (no como localhost).
HERMES_MCP_MONGO_URI=mongodb://usuario:clave@host.docker.internal:27017/?authSource=admin
HERMES_MCP_MONGO_DB=hermes-local

# Etapa 4: archivos de reporting en el OneDrive del usuario (solo con
# transporte HTTP). Datos del registro de la API de hermes-mcp en Entra ID.
# Sin estas tres variables, los archivos quedan en la carpeta de salidas.
# Tenants (claim tid) cuyos usuarios pueden guardar archivos, separados por comas.
# Vacio: cualquiera. Cuentas personales de Microsoft: 9188040d-6c67-4c5b-b112-36a304b66dad.
HERMES_MCP_ONEDRIVE_TENANTS=
HERMES_MCP_ONEDRIVE_CLIENT_ID=
HERMES_MCP_ONEDRIVE_SECRETO=
