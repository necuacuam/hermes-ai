# Copiar a open-webui.env (no se versiona) y completar con los datos del
# registro de aplicacion de Entra ID (ver docs/03-instalacion-y-configuracion.md).

# Direccion publica de Open WebUI: arma la URL de vuelta del login.
WEBUI_URL=http://localhost:3000

# Login con Microsoft Entra ID.
ENABLE_OAUTH_SIGNUP=true
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CLIENT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:3000/oauth/microsoft/callback
# Token del usuario emitido para la API de hermes-mcp (no para Graph), para
# que hermes-mcp lo pueda validar y usar en el flujo On-Behalf-Of.
MICROSOFT_OAUTH_SCOPE=openid email profile api://<client-id-de-hermes-mcp>/access_as_user
# Necesaria para que funcione el cierre de sesion (reemplazar <tenant>).
OPENID_PROVIDER_URL=https://login.microsoftonline.com/<tenant>/v2.0/.well-known/openid-configuration

# Se mantiene el login local, para no perder el acceso del administrador
# mientras se prueba.
ENABLE_LOGIN_FORM=true
