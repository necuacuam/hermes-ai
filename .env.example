# Copiar a .env y completar. El .env nunca se versiona.
# Detalle de cada variable: docs/03-instalacion-y-configuracion.md
#
# El .env lo lee el propio ejecutable, se arranque como se arranque. Una
# variable definida en el entorno real tiene prioridad sobre este archivo.

# --- MongoDB ---
# Obligatoria: sin ella el servidor no arranca. Al cambiarla, actualizar
# tambien origenDatos en el fichero de conocimiento.
# Se recomienda un usuario de solo lectura.
HERMES_MCP_MONGO_URI=

# Base a usar. Por defecto: hermes-local.
HERMES_MCP_MONGO_DB=hermes-local

# --- Fichero de conocimiento: NO se configura aqui ---
# HERMES_MCP_RELACIONES_PATH es obligatoria, pero va en el bloque "env" de
# claude_desktop_config.json: dice que fichero usa cada instalacion.
# Para arrancar sin Claude Desktop, definirla en la sesion:
#   PowerShell:  $env:HERMES_MCP_RELACIONES_PATH = "relaciones/relaciones.json"
#   cmd.exe:     set HERMES_MCP_RELACIONES_PATH=relaciones/relaciones.json

# --- Salidas ---
# Habilita guardarEnArchivo en reporting. Sin true, no se generan archivos y
# el agente informa al usuario si pide uno. Por defecto: false.
HERMES_MCP_GUARDAR_ARCHIVOS=false
# Carpeta donde reporting guarda los archivos (guardarEnArchivo=true).
# Puede contener datos reales: no se versiona. Por defecto: ./salidas
HERMES_MCP_SALIDAS_DIR=./salidas
# Zona horaria de la carpeta del dia. Por defecto: Europe/Madrid.
HERMES_MCP_ZONA_HORARIA=Europe/Madrid

# --- Limites ---
# Maximo de filas que reporting devuelve al agente. El agente no lo puede
# cambiar; para el resultado completo, archivo. Por defecto: 10.
HERMES_MCP_LIMITE_PANTALLA=10
# Tiempo maximo por consulta (formato 30s, 2m). MongoDB tambien lo recibe
# (maxTimeMS). Por defecto: 30s.
HERMES_MCP_MONGO_TIMEOUT=30s
